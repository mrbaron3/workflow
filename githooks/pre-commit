#!/usr/bin/env bash
# Project pre-commit gate. Enabled via: git config core.hooksPath githooks
set -euo pipefail

# 1. Vendored skill libs must match their single source under apps/agentops/src/ (no silent drift).
npm run bundle-skills -- --check

# 2. The Go registration validator embeds the TypeScript-owned hard-gate namespace.
npm run sync-hard-gates -- --check

# 3. markdownlint on staged markdown (project rule: lint .md before commit).
md=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)
if [ -n "$md" ]; then
  # shellcheck disable=SC2086
  npx markdownlint-cli2 $md
fi

# 4. Authoring signing-gate lint (AUTH-B): any requirement dir with a staged
#    requirements.md (legacy: spec.md) / acceptance.yaml must pass coverage /
#    no-renumber / no-manual before commit.
#    Code enforces integrity here, not the to-spec skill (skill-independent).
specdirs=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '/(requirements\.md|spec\.md|acceptance\.yaml)$' \
  | xargs -r -n1 dirname | sort -u || true)
for d in $specdirs; do
  if { [ -f "$d/requirements.md" ] || [ -f "$d/spec.md" ]; } && [ -f "$d/acceptance.yaml" ]; then
    npx tsx .claude/skills/to-spec/scripts/check-spec.ts "$d"
  fi
done
