    "decisions": [
      {
        "action": "reuse",
        "id": "decision-reuse-alert",
        "rationale": "baselineの原因・影響を操作より先に提示するalert semanticsは、last error、disconnect、rejectionの表示にそのまま適用できる",
        "sourceRequirementIds": [
          "REQ-CISO05-003",
          "REQ-CISO05-006",
          "REQ-CISO05-007",
        ],
        "targetId": "component.alert",
        "targetType": "component",
      },
      {
        "action": "extend",
        "id": "decision-extend-layout-focus-tokens",
        "rationale": "baselineの単一failed colorから、44px target、3px focus ring、responsive panel spacingを含む操作可能なDashboard token deltaへ拡張する",
        "sourceRequirementIds": [
          "REQ-CISO05-006",
        ],
        "targetId": "component.focusRing",
        "targetType": "token",
      },
      {
        "action": "extend",
        "id": "decision-extend-registration-card",
        "rationale": "baselineのdesired／actual cardへRegistration version、mode impact、component anomaly、last-good、selection、loading／empty／disconnected truthfulnessを追加する",
        "sourceRequirementIds": [
          "REQ-CISO05-001",
          "REQ-CISO05-002",
          "REQ-CISO05-003",
          "REQ-CISO05-004",
          "REQ-CISO05-006",
        ],
        "targetId": "component.repository-status-card",
        "targetType": "component",
      },
      {
        "action": "extend",
        "id": "decision-extend-failure-recovery",
        "rationale": "baselineの原因→影響→許可操作→結果の順序へlast-good、Registration version、attempt conflict、acceptedとverified successの分離を追加する",
        "sourceRequirementIds": [
          "REQ-CISO05-003",
          "REQ-CISO05-006",
          "REQ-CISO05-007",
        ],
        "targetId": "pattern.failure-recovery",
        "targetType": "pattern",
      },
      {
        "action": "create",
        "id": "decision-create-status-token-family",
        "rationale": "critical、stale、disconnected、healthy、neutralをforeground／background／borderの組で表し、色以外のlabelと併用するsemantic familyが必要である",
        "sourceRequirementIds": [
          "REQ-CISO05-003",
          "REQ-CISO05-006",
        ],
        "targetId": "color.status",
        "targetType": "token",
      },
      {
        "action": "create",
        "id": "decision-create-command-verification-status",
        "rationale": "create、update、disable、retryのstructured command outcomeとauthoritative re-query verificationを同じ語彙、focus、live announcementで表す共有componentが必要である",
        "sourceRequirementIds": [
          "REQ-CISO05-002",
          "REQ-CISO05-003",
          "REQ-CISO05-006",
          "REQ-CISO05-007",
        ],
        "targetId": "component.command-verification-status",
        "targetType": "component",
      },
      {
        "action": "create",
        "id": "decision-create-connection-banner",
        "rationale": "個別componentより上位のControl API接続、snapshot鮮度、last successful read、mutation可否を一貫して伝える共有componentがbaselineにない",
        "sourceRequirementIds": [
          "REQ-CISO05-003",
          "REQ-CISO05-005",
          "REQ-CISO05-006",
        ],
        "targetId": "component.connection-freshness-banner",
        "targetType": "component",
      },
      {
        "action": "create",
        "id": "decision-create-delivery-recovery-panel",
        "rationale": "delivery reason、route attempts、Registration version、retry attempts、idempotent command outcomeを同じcontextで扱うcompound componentが必要である",
        "sourceRequirementIds": [
          "REQ-CISO05-003",
          "REQ-CISO05-006",
          "REQ-CISO05-007",
        ],
        "targetId": "component.delivery-recovery-panel",
        "targetType": "component",
      },
      {
        "action": "create",
        "id": "decision-create-desired-actual-matrix",
        "rationale": "Issue、PR、Forwarder、Execution、Queueをdesired、actual、freshness、last-good、impactの同一column contractで比較する必要がある",
        "sourceRequirementIds": [
          "REQ-CISO05-001",
          "REQ-CISO05-003",
          "REQ-CISO05-004",
          "REQ-CISO05-006",
        ],
        "targetId": "component.desired-actual-matrix",
        "targetType": "component",
      },
      {
        "action": "create",
        "id": "decision-create-anomaly-first-dashboard",
        "rationale": "global mode／connectionから異常summary、Registration card、detailへ進むattention hierarchyを反復可能なpage compositionとして固定する",
        "sourceRequirementIds": [
          "REQ-CISO05-001",
          "REQ-CISO05-003",
          "REQ-CISO05-004",
          "REQ-CISO05-006",
        ],
        "targetId": "pattern.anomaly-first-dashboard",
        "targetType": "pattern",
      },
      {
        "action": "create",
        "id": "decision-create-loopback-session-pattern",
        "rationale": "script-free one-time bootstrap、server-side opaque session、exact Host／Origin、memory-only CSRF proof、logout／expiryをbearer非露出の一続きのbrowser security patternとして固定する",
        "sourceRequirementIds": [
          "REQ-CISO05-005",
          "REQ-CISO05-006",
        ],
        "targetId": "pattern.loopback-operator-session",
        "targetType": "pattern",
      },
      {
        "action": "create",
        "id": "decision-create-truthful-async-state",
        "rationale": "loading、empty、stale、disconnected、rejected、conflict、accepted、verified successを全query／commandで同じ意味に保つ必要がある",
        "sourceRequirementIds": [
          "REQ-CISO05-002",
          "REQ-CISO05-003",
          "REQ-CISO05-006",
          "REQ-CISO05-007",
        ],
        "targetId": "pattern.truthful-async-state",
        "targetType": "pattern",
      },
      {
        "action": "feature-local",
        "id": "decision-feature-local-registration-editor",
        "rationale": "Registration専用field、version fence、禁止field境界、disable impactは他featureへ一般化せず、このDashboardの安全契約内に閉じる",
        "sourceRequirementIds": [
          "REQ-CISO05-002",
          "REQ-CISO05-005",
          "REQ-CISO05-006",
        ],
        "targetId": "component.registration-editor",
        "targetType": "component",
      },
      {
        "action": "feature-local",
        "id": "decision-feature-local-safe-mutation",
        "rationale": "same-origin session、CSRF、strict fields、version fence、authoritative re-queryをRegistration create／update／disableに限定した安全なmutation sequenceとして定義する",
        "sourceRequirementIds": [
          "REQ-CISO05-002",
          "REQ-CISO05-005",
          "REQ-CISO05-006",
        ],
        "targetId": "pattern.safe-registration-mutation",
        "targetType": "pattern",
      },
    ],
    "patterns": [
      {
        "action": "extend",
        "compositionRules": [
          "failure summaryを回復操作より先に置く",
          "current durable state、observed attempts、Registration versionをRetry直前に表示する",
          "applied、duplicate、pending、processed、rejected、version conflict、indeterminate、verified successを別stateとして扱う",
          "command outcomeをaction直後とvisible live regionの両方へ同じ文言で表示する",
          "debug detailはprogressive disclosureへ置き、原因とrecoverabilityは常時表示する",
          "disconnectedまたはstaleな判断材料ではRetryを無効化する",
        ],
        "id": "pattern.failure-recovery",
        "name": "Failure Recovery",
        "purpose": "原因、影響、last-good、version、許可された回復操作、受付／拒否／競合、verified resultを同じcontextで提示する",
        "sourceRequirementIds": [
          "REQ-CISO05-003",
          "REQ-CISO05-006",
          "REQ-CISO05-007",
        ],
      },
      {
        "action": "create",
        "compositionRules": [
          "mode、connection、snapshot freshnessを全Registrationより先に置く",
          "failed、disconnected、stale、desired／actual divergenceをfresh healthyより先に並べる",
          "Registration card選択で同一pageのdetailを更新し別routeへ遷移しない",
          "component matrixの後にlast poll、last delivery、queue、active job、last error、recoveryを置く",
          "mutation actionは診断情報より低いprominenceにし、disableは通常editから分離する",
          "emptyはzero Registration、disconnectedはauthoritative source unavailableとして別stateにする",
        ],
        "id": "pattern.anomaly-first-dashboard",
        "name": "Anomaly-first Operations Dashboard",
        "purpose": "global contextから異常対象、component原因、安全な次操作へattentionを段階的に導く",
        "sourceRequirementIds": [
          "REQ-CISO05-001",
          "REQ-CISO05-003",
          "REQ-CISO05-004",
          "REQ-CISO05-006",
        ],
      },
      {
        "action": "create",
        "compositionRules": [
          "script-free GET bootstrapだけをno-Origin例外とし、loopback peer、exact Host、expiry、single use、constant-time token comparisonを要求する",
          "bootstrap成功はapplication assetsより前にclean URLへredirectし、one-time tokenをhistoryとsubresource requestへ残さない",
          "opaque session IDはserver-sideに保持し、HttpOnly、SameSite=Strict、path-scoped、expiring、HTTPS時Secure cookieだけをbrowserへ渡す",
          "GET browser-sessionはauthenticated、expiry、non-secret CSRF proofだけを返し、proofはmemoryだけに保持してrenewal時rotate、logout／expiry時invalidateする",
          "unsafe requestはbusiness inputより前にexact Host、byte-for-byte exact Origin、same-origin Sec-Fetch-Site、X-CSRF-Tokenを検証する",
          "missing、null、alternate loopback spelling、scheme／port／user-info／suffix／prefix variantはfail closedにする",
          "bearer、session ID、CSRF proofをHTML、JavaScript bundle、DOM、URL、persistent storage、response body、logへ置かない",
          "CSPはdefault-src／connect-srcをselfへ限定しobject／frame／baseを禁止し、frame-ancestors none、nosniff、strict referrer、no-store、no permissive CORSを適用する",
        ],
        "id": "pattern.loopback-operator-session",
        "name": "Loopback Operator Session",
        "purpose": "既存long-lived bearerをbrowserへ露出せず、1つのexact configured loopback originでsessionとCSRF lifecycleを完結する",
        "sourceRequirementIds": [
          "REQ-CISO05-005",
          "REQ-CISO05-006",
        ],
      },
      {
        "action": "create",
        "compositionRules": [
          "loadingは結果領域にaria-busyと明示labelを出し、skeletonをhealthy dataに見せない",
          "emptyはfresh authoritative responseでzero itemsの場合だけ表示する",
          "staleはobserved time、last-good、freshness reasonを表示し、current healthyとしない",
          "disconnectedはcurrent stateを返さずlast successful readとlast known dataを区別する",
          "rejectedは理由とrecoverabilityをaction近傍へ表示し、入力とfocus contextを保持する",
          "conflictはcurrent versionまたはattemptを示し、人間の再判断なしに自動再送しない",
          "applied／duplicateはdurable command outcome、pendingは処理中として表示し、verified successはauthoritative re-query後だけ使う",
          "live announcementは視覚statusと同じ文言を使い、pollごとに同一errorを反復しない",
        ],
        "id": "pattern.truthful-async-state",
        "name": "Truthful Async State",
        "purpose": "queryとcommandの不確実性を成功styleへ丸めず、利用者がcurrent truthと次行動を判断できるようにする",
        "sourceRequirementIds": [
          "REQ-CISO05-002",
          "REQ-CISO05-003",
          "REQ-CISO05-006",
          "REQ-CISO05-007",
        ],
      },
      {
        "action": "feature-local",
        "compositionRules": [
          "mutation前にopaque HttpOnly same-origin operator session、exact Host、byte-for-byte exact Origin、same-origin Sec-Fetch-Site、memory-only X-CSRF-Tokenを要求する",
          "create inputはcanonical owner/nameと4 desired switchesだけ、updateはimmutable identityと許可switch差分だけにする",
          "全mutationへrequest-specific Idempotency-Keyを付け、update／disableはoperatorが確認したcurrent versionへIf-Matchで束縛し、retryはobserved attemptsとcurrent Registration versionへ束縛する",
          "unknown field、command、host path、credential、image、mount、URL、任意configurationをUIにもpayloadにも含めない",
          "同じkey／同じnormalized inputは同じdurable outcomeへ収束し、同じkey／異inputは拒否する。pending中の二重submitを防ぎ、transport outcome unknownは同じkey／同じinputでのみ再送する",
          "conflict時はauthoritative snapshotを再取得して差分と影響を再判断する",
          "successはpersisted Registration identity、version、desired valuesをre-queryで確認後に通知する",
          "disable後はactual stopped／rejected workが未観測ならconvergingと表示し、古いjobをsuccess扱いしない",
        ],
        "id": "pattern.safe-registration-mutation",
        "name": "Safe Registration Mutation",
        "purpose": "create、update、disableをsame-origin security boundary、strict schema、version／idempotency fence、authoritative verificationへ通す",
        "sourceRequirementIds": [
          "REQ-CISO05-002",
          "REQ-CISO05-003",
          "REQ-CISO05-005",
          "REQ-CISO05-006",
        ],
      },
    ],
