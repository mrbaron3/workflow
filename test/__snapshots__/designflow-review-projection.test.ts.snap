        ],
      },
      {
        "action": "create",
        "contentConstraints": [
          "2xx／202、applied、duplicateを単独でverified successと表現しない",
          "version conflictはobserved／current version、retry conflictはobserved／current attemptsを示す",
          "indeterminateは同じIdempotency-Key／同じinputの再送またはauthoritative re-queryだけを案内する",
          "verified successはresource identity、version／attempt identity、desired／delivery／recovery fieldsの一致後だけ使う",
        ],
        "focusBehavior": "applied／duplicate／verifyingではfocusを動かさずpoliteに通知する。rejected／version conflict／indeterminate／verification mismatchでは同じdialogまたはpanelのsummaryへfocusを移す。verified後はtriggerまたはselected cardへ戻す",
        "id": "component.command-verification-status",
        "keyboardBehavior": "status自体は非interactiveとし、Retry same key、Reload、Close等の許可actionだけをdocument orderへ置く。submitting／re-querying中は新しいcommandを発火させない",
        "name": "Command Verification Status",
        "purpose": "mutationのdurable command outcomeとauthoritative verificationを混同せず、対象identity、fence、次の行動とともに提示する",
        "responsiveRules": [
          "広幅はoutcome、fence、verificationを横に比較する",
          "狭幅はoutcome→identity→fence→verification→actionの順に縦積みする",
          "identityとreasonをellipsisで隠さない",
        ],
        "slots": [
          "outcome-label",
          "command-identity-digest",
          "resource-identity",
          "observed-fence",
          "result-version-or-attempt",
          "verification-target",
          "recovery-action",
        ],
        "sourceRequirementIds": [
          "REQ-CISO05-002",
          "REQ-CISO05-003",
          "REQ-CISO05-006",
          "REQ-CISO05-007",
        ],
        "states": [
          "idle",
          "submitting",
          "outcome-received",
          "re-querying",
          "verified",
          "verification-mismatch",
        ],
        "tokenRefs": [
          "color.status.critical.foreground",
          "color.status.healthy.foreground",
          "color.status.neutral.foreground",
          "color.status.stale.foreground",
          "component.focusRing.color",
          "size.target.minimum",
        ],
        "variants": [
          "applied",
          "duplicate",
          "version-conflict",
          "rejected",
          "indeterminate",
          "verifying",
          "verified-success",
        ],
      },
      {
        "action": "create",
        "contentConstraints": [
          "disconnected時のlast known dataをfreshと表現しない",
          "staleとdisconnectedを同じ文言にしない",
          "modeが取得不能ならunknownと明記する",
          "bearer、session ID、CSRF proof自体は表示せず、authenticated／expired／rejectedとexpiryだけを表示する",
        ],
        "focusBehavior": "refresh結果でfocusを動かさずvisible live regionへ通知する。session rejectionはpage headingの後でassertiveに通知する",
        "id": "component.connection-freshness-banner",
        "keyboardBehavior": "Refreshはnative buttonでEnter／Spaceから利用でき、pending中だけdisabledにする",
        "name": "Connection and Freshness Banner",
        "purpose": "Control API接続、opaque browser session／expiry、snapshot observed time、last successful read、mutation可否を全Registrationより先に伝える",
        "responsiveRules": [
          "広幅はmode、connection、time、actionを同一rowにする",
          "狭幅はlabel/valueを縦積みし、last successful timeとdisabled reasonを省略しない",
