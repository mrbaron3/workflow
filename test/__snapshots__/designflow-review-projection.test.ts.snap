      {
        "action": "create",
        "contentConstraints": [
          "acceptedをprocessedまたはsuccessと表現しない",
          "retry対象delivery IDとobserved attemptsを手入力させない",
          "rejected attemptもattempt identity、reason、timeを表示する",
          "disconnected時はRetryを無効化しlast known detailを明示する",
        ],
        "focusBehavior": "failure item選択後もitem focusを維持してdetail更新を通知する。rejection／conflictではoutcome summaryへfocusを移し、acceptedではfocusを動かさない",
        "id": "component.delivery-recovery-panel",
        "keyboardBehavior": "failure itemとRetryはnative button semanticsを使い、Retry pending中の二重発火を防ぐ。attempt historyはdocument orderで読む",
        "name": "Delivery Recovery Panel",
        "purpose": "failure identity、原因、attempt、Registration version、retry可否、command outcomeを同じ文脈で提示する",
        "responsiveRules": [
