  "effortBudgets": [
    {
      "id": "effort-triage-anomaly",
      "maxContextSwitches": 0,
      "maxDecisions": 1,
      "maxPrimaryActions": 2,
      "rationale": "初期表示で異常を露出し、対象選択だけで原因と回復候補へ到達する。stale時の明示refreshを含めても同一page内2 actionに収める",
      "repeatedInputAllowed": false,
      "task": {
        "goal": "異常を優先して発見し、desired／actual差、鮮度、最終正常時刻、影響、回復候補を判断する",
        "id": "task-triage-anomaly",
      },
    },
    {
      "id": "effort-create-registration",
      "maxContextSwitches": 0,
      "maxDecisions": 1,
      "maxPrimaryActions": 2,
      "rationale": "dialogを開き保存する2 actionとし、repository identityを再入力させない。入力validationは送信前と同じdialog内で完了する",
      "repeatedInputAllowed": false,
      "task": {
        "goal": "許可されたrepository identityとdesired switchesだけでRegistrationを作成し、永続versionを確認する",
        "id": "task-create-registration",
      },
    },
    {
      "id": "effort-update-registration",
      "maxContextSwitches": 0,
      "maxDecisions": 1,
      "maxPrimaryActions": 2,
      "rationale": "編集開始と保存の2 actionで完了し、immutable identityとcurrent valuesを事前入力する。version conflict時だけ安全のため再読込後の再判断を要求する",
      "repeatedInputAllowed": false,
      "task": {
        "goal": "確認済みversionに対してmonitorとexecutionのdesired switchesを更新し、競合を誤って成功表示しない",
        "id": "task-update-registration",
      },
    },
    {
      "id": "effort-disable-registration",
      "maxContextSwitches": 0,
      "maxDecisions": 2,
      "maxPrimaryActions": 2,
      "rationale": "無効化開始と確認の2 actionを必要な安全摩擦として残し、停止影響とversionを確認する2つの判断を保護する",
      "repeatedInputAllowed": false,
      "task": {
        "goal": "影響とcurrent versionを確認してRegistrationを無効化し、古いjobが有効にならない結果を確認する",
        "id": "task-disable-registration",
      },
    },
    {
      "id": "effort-recover-delivery",
      "maxContextSwitches": 0,
      "maxDecisions": 1,
      "maxPrimaryActions": 2,
      "rationale": "failure選択とretryの2 actionにし、delivery ID、attempt数、idempotency identityの再入力を求めず、原因確認から結果追跡まで同じpanelに留める",
      "repeatedInputAllowed": false,
      "task": {
        "goal": "失敗deliveryの原因、attempt、Registration versionを確認し、許可された場合だけidempotentにretryする",
        "id": "task-recover-delivery",
      },
    },
  ],
  "elements": [
    {
      "id": "element-connection-freshness",
      "informationPriority": 1,
      "interactionRationale": "loading、fresh、stale、disconnected、auth-rejectedをlabel、observed time、last successful read、session expiryで示す。browserはopaque HttpOnly session cookieだけで認証し、CSRF proofはmemory-only、unsafe methodはexact Originとsame-origin Sec-Fetch-Siteを要求する。disconnected／expired時はmutationを無効化する",
      "kind": "connection-status-banner",
      "label": "Control API connection and snapshot freshness",
      "placementRationale": "全表示値とmutationの信頼性に影響するためmodeと並べ、個別healthy表示より先に読ませる",
      "region": {
        "groupingRationale": "Placement: page heading直後かつ全Registrationより前に置く。Interaction: modeとconnectionは表示専用、refreshだけを近接actionとして提供する。Removal impact: 全表示値の信頼性とmutation可否を判断できず、stale／disconnectedをhealthyと誤認する",
        "id": "region-global-status",
        "order": 1,
        "prominence": "primary",
        "purpose": "運転mode、Control API接続、snapshot鮮度、page purposeを全Repository情報より先に伝える",
        "responsiveBehavior": "全viewportでpage先頭に維持し、mode、接続、last successful readを省略しない。狭幅ではlabel/valueを縦積みにする",
      },
      "removalImpact": "古いsnapshotまたはDB不達時の値を現在のhealthy stateとして誤認し、失敗commandを成功と扱う",
