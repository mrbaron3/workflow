      "uri": "https://github.com/mrbaron3/workflow/tree/af16c6ac9e75aac949c9a4e81d6f1877a292e313/contracts/designflow/contract-v1.0.0-rc.1/contracts/v1/examples",
    },
    "components": [
      {
        "action": "reuse",
        "contentConstraints": [
          "error codeだけでなく原因、影響、recoverabilityを平文で示す",
          "verified-success variantはauthoritative re-query後だけ使用する",
          "criticalとwarningを色だけで区別しない",
        ],
        "focusBehavior": "query failureではfocusを奪わずlive announcementする。form submission rejectionではdialog内error summaryへfocusを移す",
        "id": "component.alert",
        "keyboardBehavior": "alert自体は非interactiveとし、内部detailsとactionはdocument orderでTab移動する。critical alertを自動dismissしない",
        "name": "Alert",
        "purpose": "failure、disconnect、rejection、conflictの原因、影響、last-good、次の許可行動を操作より先に伝える",
        "responsiveRules": [
          "320px幅でstatus label、summary、time、actionを縦積みにする",
          "長いerrorとrepository identityを省略せず折り返す",
        ],
        "slots": [
          "status-label",
          "summary",
          "impact",
          "last-good",
          "recovery",
          "debug-disclosure",
        ],
        "sourceRequirementIds": [
          "REQ-CISO05-003",
          "REQ-CISO05-006",
          "REQ-CISO05-007",
        ],
        "states": [
          "default",
          "expanded",
          "dismissed-when-nonblocking",
        ],
        "tokenRefs": [
          "color.status.critical.background",
          "color.status.critical.border",
          "color.status.critical.foreground",
          "color.status.healthy.background",
          "color.status.healthy.foreground",
          "color.status.stale.background",
          "color.status.stale.border",
          "color.status.stale.foreground",
        ],
        "variants": [
          "critical",
          "warning",
          "information",
          "verified-success",
        ],
      },
      {
        "action": "extend",
        "contentConstraints": [
          "canonical owner/nameを完全に識別可能に表示する",
          "desiredとactualを同一labelまたは単一toggleへ結合しない",
          "stale、unknown、disabled、healthyをtext labelで区別する",
          "loading skeletonに実データ風のstatus色を使わない",
        ],
        "focusBehavior": "選択後もcardへfocusを維持し、detail headingと異常summaryをpolite live regionで通知する。pagination追加後も既存focusを維持する",
        "id": "component.repository-status-card",
        "keyboardBehavior": "card全体をnative button相当としEnter／Spaceで選択する。内部にnested interactive controlを置かない",
        "name": "Repository Status Card",
        "purpose": "Registration identity、version、最重要のdesired／actual差、last-goodを異常優先listで比較・選択可能にする",
        "responsiveRules": [
          "768px以上は固定幅list、未満はfull-width cardにする",
          "狭幅ではidentity→anomaly→version→last-goodの順に縦積みし、errorをellipsisで隠さない",
          "touch targetは44px以上を保つ",
        ],
        "slots": [
          "repository-name",
          "registration-id",
          "registration-version",
          "desired-summary",
          "actual-summary",
          "mode-impact",
          "anomaly-label",
          "last-good",
          "updated-time",
        ],
        "sourceRequirementIds": [
          "REQ-CISO05-001",
          "REQ-CISO05-002",
          "REQ-CISO05-003",
          "REQ-CISO05-004",
          "REQ-CISO05-006",
        ],
        "states": [
          "default",
          "hover",
          "focused",
          "selected",
          "loading",
          "empty-list",
          "last-known",
        ],
        "tokenRefs": [
          "color.status.critical.foreground",
          "color.status.disconnected.foreground",
          "color.status.healthy.foreground",
          "color.status.neutral.foreground",
          "color.status.stale.foreground",
          "component.focusRing.color",
          "component.focusRing.width",
          "component.registrationCard.selectedBackground",
          "component.registrationCard.selectedBorder",
          "size.target.minimum",
