      },
      {
        "action": "create",
        "contentConstraints": [
          "desiredとactualは別column／labelを持つ",
          "観測がない場合は空欄ではなくUnknownまたはNever observedと表示する",
          "last-goodはcurrent stateと同じ視覚weightにしない",
          "MONITOR_ONLYでenabledかつexecution-enabledのExecution actualはpaused_by_modeとし、failedやrunningへ推測しない",
          "Issue Monitor 300秒、PR Monitor 300秒、Forwarder 60秒、Execution 30秒、Queue 15秒のbudgetを各rowに明示する",
          "last-goodはhistorical evidenceでありcurrent failureのhealthy stylingへ使用しない",
        ],
        "focusBehavior": "Registration選択でfocusを移さず、matrix summaryをpolite live regionへ通知する",
        "id": "component.desired-actual-matrix",
        "keyboardBehavior": "matrix自体は非interactiveとし、semantic tableまたはdefinition groupsでscreen readerのrow／column relationを保つ。debug disclosureだけをTab順に含める",
        "name": "Desired / Actual Matrix",
        "purpose": "Issue Monitor、PR Monitor、Forwarder、Execution、Queueのintentと観測を同じ読取順で比較する",
        "responsiveRules": [
          "768px以上はsemantic tableとしてcomponent rowを揃える",
          "767px以下はcomponentごとのdefinition groupへ変換し、column labelを各valueへ繰り返す",
          "二方向scrollを必須にせずerrorとtimestampを折り返す",
        ],
