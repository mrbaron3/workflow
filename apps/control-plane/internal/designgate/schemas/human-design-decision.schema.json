{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:designflow:schema:v1:human-design-decision",
  "title": "Human Design Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "requestId",
    "revisionId",
    "bundleDigest",
    "verdict",
    "rationale",
    "decidedBy",
    "decidedAt",
    "supersedesDecisionId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "decisionId": {
      "$ref": "urn:designflow:schema:v1:common#/$defs/identifier"
    },
    "requestId": {
      "$ref": "urn:designflow:schema:v1:common#/$defs/identifier"
    },
    "revisionId": {
      "$ref": "urn:designflow:schema:v1:common#/$defs/identifier"
    },
    "bundleDigest": {
      "$ref": "urn:designflow:schema:v1:common#/$defs/sha256"
    },
    "verdict": {
      "enum": ["approve", "request-changes", "reject"]
    },
    "rationale": {
      "$ref": "urn:designflow:schema:v1:common#/$defs/nonEmptyString"
    },
    "decidedBy": {
      "$ref": "urn:designflow:schema:v1:common#/$defs/actor"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "supersedesDecisionId": {
      "anyOf": [
        {
          "$ref": "urn:designflow:schema:v1:common#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
