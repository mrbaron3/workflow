{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrbaron3/workflow/contracts/github-credential/v1/token-request.schema.json",
  "title": "AgentOps GitHub credential broker request v1",
  "description": "Internal-network-only request authenticated by a role capability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "role", "repository"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "role": {
      "type": "string",
      "enum": ["triage", "runner"]
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9_.-]{1,100}$"
    }
  }
}
