{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrbaron3/workflow/contracts/github-credential/v1/token-response.schema.json",
  "title": "AgentOps ephemeral GitHub installation credential response v1",
  "description": "Secret response that must remain in process memory and must never be persisted or logged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "role",
    "token",
    "expiresAt",
    "repositories",
    "permissions",
    "actorLogin"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "role": {
      "type": "string",
      "enum": ["triage", "runner"]
    },
    "token": {
      "type": "string",
      "minLength": 20,
      "maxLength": 4096
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/(?!\\.{1,2}$)[a-z0-9_.-]{1,100}$"
      }
    },
    "permissions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z_]{1,64}$"
      },
      "additionalProperties": {
        "type": "string",
        "enum": ["read", "write"]
      }
    },
    "actorLogin": {
      "type": "string",
      "minLength": 6,
      "maxLength": 106,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\[bot\\]$"
    }
  }
}
