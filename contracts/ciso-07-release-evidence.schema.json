{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrbaron3/workflow/contracts/ciso-07-release-evidence.schema.json",
  "title": "CISO-07 integrated dogfood release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "issue",
    "source",
    "images",
    "topology",
    "registration",
    "monitoring",
    "execution",
    "recovery",
    "formalReviews",
    "github",
    "artifacts",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "issue": { "const": "mrbaron3/workflow#17" },
    "source": { "$ref": "#/$defs/source" },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "runner", "postgres"],
      "properties": {
        "control": { "$ref": "#/$defs/digest" },
        "runner": { "$ref": "#/$defs/digest" },
        "postgres": { "$ref": "#/$defs/digest" }
      }
    },
    "topology": { "$ref": "#/$defs/evidenceSection" },
    "registration": { "$ref": "#/$defs/evidenceSection" },
    "monitoring": { "$ref": "#/$defs/evidenceSection" },
    "execution": { "$ref": "#/$defs/execution" },
    "recovery": { "$ref": "#/$defs/evidenceSection" },
    "formalReviews": { "$ref": "#/$defs/reviews" },
    "github": { "$ref": "#/$defs/github" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "result": { "const": "passed" }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutableBase", "finalHead", "treeSha256"],
      "properties": {
        "immutableBase": { "$ref": "#/$defs/sha" },
        "finalHead": { "$ref": "#/$defs/sha" },
        "treeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceSection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["passed"],
      "properties": {
        "passed": { "const": true }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["passed", "jobId", "attemptId", "leaseId", "expectedHead"],
      "properties": {
        "passed": { "const": true },
        "jobId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "leaseId": { "type": "string", "minLength": 1 },
        "expectedHead": { "$ref": "#/$defs/sha" }
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roundCount", "round1", "round2", "round3Created"],
      "properties": {
        "roundCount": { "const": 2 },
        "round1": { "$ref": "#/$defs/evidenceSection" },
        "round2": { "$ref": "#/$defs/evidenceSection" },
        "round3Created": { "const": false }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "pullRequest",
        "finalPrHead",
        "mergeSha",
        "issueState",
        "issueStateReason",
        "mergeReachableFromOriginMain"
      ],
      "properties": {
        "pullRequest": { "type": "integer", "minimum": 1 },
        "finalPrHead": { "$ref": "#/$defs/sha" },
        "mergeSha": { "$ref": "#/$defs/sha" },
        "issueState": { "const": "CLOSED" },
        "issueStateReason": { "const": "COMPLETED" },
        "mergeReachableFromOriginMain": { "const": true }
      }
    }
  }
}
