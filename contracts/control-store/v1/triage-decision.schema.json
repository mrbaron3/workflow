{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrbaron3/workflow/contracts/control-store/v1/triage-decision.schema.json",
  "title": "AgentOps issue triage decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "northStarAlignment",
    "readiness",
    "priority",
    "summary",
    "rationale",
    "dependencies",
    "duplicateCandidates",
    "missingInformation"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "type": {
      "type": "string",
      "enum": ["feature", "bug", "tech_debt", "question", "documentation"]
    },
    "northStarAlignment": {
      "type": "string",
      "enum": ["aligned", "unclear", "misaligned"]
    },
    "readiness": {
      "type": "string",
      "enum": ["ready_candidate", "blocked", "needs_info"]
    },
    "priority": {
      "type": "string",
      "enum": ["p0", "p1", "p2", "p3"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "issueNumber", "relationship"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/(?:[a-z0-9_-]|[a-z0-9_-][a-z0-9_.-]|\\.[a-z0-9_-]|[a-z0-9_.-]{3,100})$"
          },
          "issueNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "relationship": {
            "type": "string",
            "enum": ["blocks", "blocked_by", "relates_to"]
          }
        }
      }
    },
    "duplicateCandidates": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "issueNumber", "reason"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/(?:[a-z0-9_-]|[a-z0-9_-][a-z0-9_.-]|\\.[a-z0-9_-]|[a-z0-9_.-]{3,100})$"
          },
          "issueNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        }
      }
    },
    "missingInformation": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      }
    }
  }
}
