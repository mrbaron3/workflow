{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrbaron3/workflow/contracts/control-store/v1/runner-result.schema.json",
  "title": "AgentOps isolated runner result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "jobId",
    "attemptNumber",
    "repository",
    "headSha",
    "pullRequestNumber",
    "artifacts",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "succeeded" },
    "jobId": { "type": "string", "format": "uuid" },
    "attemptNumber": { "type": "integer", "minimum": 1 },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$"
    },
    "headSha": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        { "type": "null" }
      ]
    },
    "pullRequestNumber": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "runner-job.schema.json#/$defs/artifact" }
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
