{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrbaron3/workflow/contracts/control-store/v1/runner-result.schema.json",
  "title": "AgentOps isolated runner result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "jobId",
    "attemptNumber",
    "repository",
    "headSha",
    "pullRequestNumber",
    "artifacts",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "succeeded" },
    "jobId": { "type": "string", "format": "uuid" },
    "attemptNumber": { "type": "integer", "minimum": 1 },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/(?!\\.{1,2}$)[a-z0-9_.-]{1,100}$"
    },
    "outcome": {
      "enum": ["completed", "needs-human-review"],
      "default": "completed"
    },
    "humanReview": {
      "default": null,
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issueNumber",
            "reasonCount",
            "commentUrl",
            "classification",
            "howIntervention",
            "aiAppliedReadyLabel",
            "claimedLabelRemoved"
          ],
          "properties": {
            "issueNumber": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "reasonCount": { "type": "integer", "minimum": 1 },
            "commentUrl": { "type": "string", "format": "uri" },
            "classification": { "const": "what-judgment" },
            "howIntervention": { "const": false },
            "aiAppliedReadyLabel": { "const": false },
            "claimedLabelRemoved": { "const": true }
          }
        },
        { "type": "null" }
      ]
    },
    "headSha": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        { "type": "null" }
      ]
    },
    "pullRequestNumber": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "runner-job.schema.json#/$defs/artifact" }
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "dependentRequired": {
    "humanReview": ["outcome"]
  },
  "allOf": [
    {
      "if": {
        "required": ["outcome"],
        "properties": { "outcome": { "const": "needs-human-review" } }
      },
      "then": {
        "required": ["humanReview"],
        "properties": {
          "humanReview": { "type": "object" },
          "headSha": { "type": "null" },
          "pullRequestNumber": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "required": ["outcome"],
        "properties": { "outcome": { "const": "completed" } }
      },
      "then": {
        "properties": {
          "humanReview": { "type": "null" }
        }
      }
    }
  ]
}
