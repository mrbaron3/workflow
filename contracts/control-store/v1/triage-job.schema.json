{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrbaron3/workflow/contracts/control-store/v1/triage-job.schema.json",
  "title": "AgentOps issue triage job payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "issue"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name"],
      "properties": {
        "owner": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$" },
        "name": { "type": "string", "pattern": "^(?!\\.{1,2}$)[a-z0-9_.-]{1,100}$" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "observedUpdatedAt"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "observedUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
