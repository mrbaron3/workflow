{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:designflow:schema:v1:common",
  "title": "Experience Contract common definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "externalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "externalId"],
      "properties": {
        "provider": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "externalId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "priority", "sourceRefs"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "priority": {
          "enum": ["blocker", "major", "minor"]
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "statement"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "enum": [
            "product",
            "brand",
            "accessibility",
            "security",
            "legal",
            "technical",
            "operational",
            "other"
          ]
        },
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "mediaType", "schemaRef"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\./).+$"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "mediaType": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "schemaRef": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "subject"],
      "properties": {
        "provider": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "subject": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "displayName": {
          "type": "string"
        }
      }
    }
  }
}
