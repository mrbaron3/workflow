        }
      ]
    }
  ],
  "constraints": [
    {
      "id": "CONSTRAINT-CISO05-A11Y",
      "category": "accessibility",
      "statement": "WCAG 2.2 AA相当とし、状態を色だけで伝えず、全操作をkeyboardで完了し、focusとlive announcementを予測可能にする"
    },
    {
      "id": "CONSTRAINT-CISO05-SECURITY",
      "category": "security",
      "statement": "Dashboardへcontainer lifecycle、Apple Container socket、PostgreSQL、provider、host filesystem、credentialへの権限を与えない"
    },
    {
      "id": "CONSTRAINT-CISO05-CAPABILITY",
      "category": "technical",
      "statement": "全Backend Capability Requirementを#13 Control API、registration-control system element、Issue ACへ完全traceできない限り実装へ進めない"
    },
    {
      "id": "CONSTRAINT-CISO05-TRUTHFULNESS",
      "category": "operational",
      "statement": "unknown、stale、disconnected、failedをhealthyまたは更新成功として表示せず、利用可能な最終正常時刻を併記する"
    },
    {
      "id": "CONSTRAINT-CISO05-SCOPE",
      "category": "product",
      "statement": "monitor・queue内部、runner execution、Mac上のcontainer lifecycle制御は対象外とする"
    }
  ],
