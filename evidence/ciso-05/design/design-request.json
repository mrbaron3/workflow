  },
  "productIntent": {
    "primaryOutcome": "運用者が異常のあるRepositoryを発見し、原因を理解して安全な次の操作を選べる",
    "users": [
      "ローカルAgentOps運用者"
    ],
    "usageContext": "loopbackで公開されたcontrol containerのDashboardから、複数Repositoryの登録、監視、転送、実行、queue状態を日常的に管理・観測する"
  },
  "requirements": [
    {
      "id": "REQ-CISO05-001",
      "statement": "各Registrationについてrepository identityとversion、enabled、Issue Monitor、PR Monitor、Forwarder、Execution、Queueのdesired stateとactual stateを分離して表示する",
      "priority": "blocker",
      "sourceRefs": [
        {
          "provider": "github",
          "externalId": "mrbaron3/workflow#15",
          "uri": "https://github.com/mrbaron3/workflow/issues/15",
          "revision": "2026-07-25T07:10:01Z"
        }
      ]
    },
    {
      "id": "REQ-CISO05-002",
      "statement": "repository identityとenabled、issue_monitor_enabled、pr_monitor_enabled、execution_enabledを登録・更新・無効化し、version fenceを保った結果を再起動後も確認できる",
      "priority": "blocker",
      "sourceRefs": [
        {
          "provider": "github",
          "externalId": "mrbaron3/workflow#15",
          "uri": "https://github.com/mrbaron3/workflow/issues/15",
          "revision": "2026-07-25T07:10:01Z"
        }
      ]
    },
    {
      "id": "REQ-CISO05-003",
      "statement": "last poll、last delivery、queue depth、active job、last error、last-good timestamp、recovery stateを表示し、API拒否・DB切断・monitor failure・stale observationを成功として表示しない",
      "priority": "blocker",
      "sourceRefs": [
        {
          "provider": "github",
          "externalId": "mrbaron3/workflow#15",
          "uri": "https://github.com/mrbaron3/workflow/issues/15",
          "revision": "2026-07-25T07:10:01Z"
        }
      ]
    },
    {
      "id": "REQ-CISO05-004",
      "statement": "現在のMONITOR_ONLYまたはACTIVE等の運転modeと、modeが各RegistrationのExecution actual stateへ与える影響を誤認なく表示する",
      "priority": "blocker",
      "sourceRefs": [
        {
          "provider": "github",
          "externalId": "mrbaron3/workflow#15",
          "uri": "https://github.com/mrbaron3/workflow/issues/15",
          "revision": "2026-07-25T07:10:01Z"
        },
        {
          "provider": "github",
          "externalId": "mrbaron3/workflow#10",
          "uri": "https://github.com/mrbaron3/workflow/issues/10"
        }
      ]
    },
    {
      "id": "REQ-CISO05-005",
      "statement": "browserはsame-originのControl APIだけと通信し、loopback session、exact Origin、CSRF、strict input schema、security headersを通して任意command・host path・image・mount・credential・unsafe repository identityを拒否する",
      "priority": "blocker",
      "sourceRefs": [
        {
          "provider": "github",
          "externalId": "mrbaron3/workflow#15",
          "uri": "https://github.com/mrbaron3/workflow/issues/15",
          "revision": "2026-07-25T07:10:01Z"
        }
      ]
    },
    {
      "id": "REQ-CISO05-006",
      "statement": "primary taskのEffort Budget、異常優先のAttention Hierarchy、keyboard、focus、label、live status announcement、responsive layoutを満たす",
      "priority": "blocker",
      "sourceRefs": [
        {
          "provider": "github",
          "externalId": "mrbaron3/workflow#15",
          "uri": "https://github.com/mrbaron3/workflow/issues/15",
          "revision": "2026-07-25T07:10:01Z"
        }
      ]
    },
    {
      "id": "REQ-CISO05-007",
      "statement": "失敗deliveryは原因と現在versionを確認した後に同じcontextでidempotentにretryでき、拒否・競合・受付結果を明示する",
      "priority": "major",
      "sourceRefs": [
        {
          "provider": "github",
          "externalId": "mrbaron3/workflow#15",
          "uri": "https://github.com/mrbaron3/workflow/issues/15",
          "revision": "2026-07-25T07:10:01Z"
        },
        {
