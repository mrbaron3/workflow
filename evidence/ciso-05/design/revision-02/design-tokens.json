      "critical": {
        "$type": "color",
        "foreground": {
          "$value": "{color.text.critical}",
          "$description": "Failed or rejected foreground"
        },
        "background": {
          "$value": "{color.surface.critical}"
        },
        "border": {
          "$value": "{color.border.critical}"
        }
      },
      "stale": {
        "$type": "color",
        "foreground": {
          "$value": "{color.text.warning}",
          "$description": "Stale or version-divergent foreground"
        },
        "background": {
          "$value": "{color.surface.warning}"
        },
        "border": {
          "$value": "{color.border.warning}"
        }
      },
      "disconnected": {
        "$type": "color",
        "foreground": {
          "$value": "{color.text.critical}",
          "$description": "Authoritative source unavailable"
        },
        "background": {
          "$value": "{color.surface.critical}"
        },
        "border": {
          "$value": "{color.border.critical}"
        }
      },
      "healthy": {
        "$type": "color",
        "foreground": {
          "$value": "{color.text.success}",
          "$description": "Fresh observed healthy state"
        },
        "background": {
          "$value": "{color.surface.success}"
        },
        "border": {
          "$value": "{color.border.success}"
        }
      },
      "neutral": {
        "$type": "color",
        "foreground": {
          "$value": "{color.text.secondary}",
