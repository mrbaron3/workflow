# Standard OCI application image for the AgentOps harness (AC-CISO-011).
#
# This is a plain multi-stage OCI build — no Apple-Container-specific syntax — so it builds and runs
# identically under Apple Container, docker, podman, or nerdctl. The runtime adapter, not the image,
# carries any engine-specific behaviour. Every path here is container-absolute (WORKDIR /app); nothing
# references a macOS `/Users/...` path, which the host-path scanner
# (apps/agentops/src/runtime/paths.ts) enforces.
#
# Build context is the repository root:
#   container build -t agentops-app:dev -f deploy/Containerfile .
#   docker    build -t agentops-app:dev -f deploy/Containerfile .   # standard-OCI portability check
#
# Stage boundaries consume only one app directory plus the root shared contracts/assets. The final
# topology is still released together because both apps verify the exact PostgreSQL schema checksum.

# --- deps: resolve the full dependency graph from the lockfile (reproducible) -------------------
FROM node:24.19.0-trixie-slim@sha256:85498d7fd8e2bc0b02abb1792ef27341559836236dd0b1af160fa66bb85148df AS deps
WORKDIR /app
# Only workspace manifests + lockfile, so this layer caches unless dependencies change.
COPY package.json package-lock.json ./
COPY apps/agentops/package.json ./apps/agentops/package.json
RUN npm install --global npm@12.0.2 \
    && npm --version | grep -qx '12.0.2' \
    && npm ci

# --- build: bring in the source and prove build+typecheck run in-container from container-relative paths -
FROM deps AS build
WORKDIR /app
# The TypeScript build stage deliberately does not receive Go source. Root-level assets are published
# contracts, DB migrations, documentation, and topology metadata consumed by the application.
COPY apps/agentops ./apps/agentops
COPY contracts ./contracts
COPY db ./db
COPY docs ./docs
COPY evidence ./evidence
COPY .claude ./.claude
COPY README.md CLAUDE.md ./
COPY deploy/Containerfile ./deploy/Containerfile
# Grounds "build/typecheck grader runs inside the container with no Mac absolute path" (issue #11 AC).
RUN npm run typecheck && npm run build

# --- control-build: compile and unit-test the Registration-driven Go control plane ----------------
FROM golang:1.26.5-trixie@sha256:4ee9ffa999b4583ce281939cdff828763083610292f252279a0cee77473bd9a7 AS control-build
WORKDIR /src/apps/control-plane
COPY apps/control-plane/go.mod apps/control-plane/go.sum ./
RUN go mod download
COPY apps/control-plane/cmd ./cmd
COPY apps/control-plane/internal ./internal
COPY contracts /src/contracts
COPY evidence /src/evidence
COPY db /src/db
COPY docs /src/docs
RUN go test ./... \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
      -o /out/agentops-control ./cmd/agentops-control \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
      -o /out/agentopsctl ./cmd/agentopsctl \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
      -o /out/agentops-github-broker ./cmd/agentops-github-broker \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
      -o /out/agentops-github-credential-helper \
      ./cmd/agentops-github-credential-helper

# Integration-test target. It is run on the internal test network with AGENTOPS_TEST_DATABASE_URL;
# PostgreSQL does not publish a host port in the grounded Apple Container smoke.
FROM control-build AS control-test
CMD ["go", "test", "-race", "./..."]

# --- runtime: the application image ------------------------------------------------------------
# Runs the harness via the tsx launcher (apps/agentops/bin/agentops.mjs). Retains the toolchain so the in-container
# graders (typecheck / unit tests) run against container-relative paths; a leaner prod-only split is a
# later concern (#14) and does not change this image's standard-OCI shape.
FROM node:24.19.0-trixie-slim@sha256:85498d7fd8e2bc0b02abb1792ef27341559836236dd0b1af160fa66bb85148df AS runtime
# git is part of the harness grader/runner toolchain (it shells out to git); install it reproducibly.
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260804T000000Z trixie main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260804T000000Z trixie-updates main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260804T000000Z trixie-security main' \
      > /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
      git=1:2.47.3-0+deb13u1 \
    && npm install --global npm@12.0.2 \
    && npm --version | grep -qx '12.0.2' \
    && rm -rf /opt/yarn-v* \
    && rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && rm -rf /var/lib/apt/lists/*
# Container-neutral roots (DATA-container-runtime-004). AGENTOPS_APP_ROOT is CONSUMED by the CLI
# bootstrap (resolveHarnessRoot): Store / workspace / systemDir all anchor on it, so nothing depends on
# a macOS /Users path. The WORKSPACE/STORE roots are declared here for consumers that adopt
# resolveContainerPaths as workspace/store move onto dedicated volumes (#12/#14). None carries a macOS
# dependency; here APP_ROOT=/app equals the cwd, so behavior is identical to a bare run.
ENV NODE_ENV=production \
    YARN_VERSION= \
    AGENTOPS_REPOSITORY_ROOT=/app \
    AGENTOPS_APP_ROOT=/app \
    AGENTOPS_WORKSPACE_ROOT=/workspace \
    AGENTOPS_STORE_ROOT=/data/store \
    AGENTOPS_SYSTEM_DIR=/app/docs/_system
WORKDIR /app
# The official node image ships a non-root `node` user (uid 1000); run as it, never as root.
COPY --from=build --chown=node:node /app /app
USER node
CMD ["node", "apps/agentops/bin/agentops.mjs"]

# --- runner: isolated PostgreSQL lease consumer + existing AgentOps toolchain --------------------
FROM control-build AS runner-tools
WORKDIR /src/deploy/tools/gh
COPY deploy/tools/gh/go.mod deploy/tools/gh/go.sum ./
RUN go mod download
COPY deploy/tools/gh ./
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags="-s -w -X github.com/cli/cli/v2/internal/build.Version=2.97.0" \
      -o /out/gh github.com/cli/cli/v2/cmd/gh \
    && /out/gh version \
    && /out/gh pr merge --help | grep -q -- '--match-head-commit'

FROM runtime AS runner
USER root
COPY --chown=root:root deploy/tools/provider-cli/package.json deploy/tools/provider-cli/package-lock.json /opt/provider-cli/
COPY --from=runner-tools /out/gh /usr/local/libexec/agentops-gh-real
COPY --from=control-build /out/agentops-github-credential-helper /usr/local/bin/agentops-github-credential-helper
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         bubblewrap=0.11.0-2+deb13u1 \
         ca-certificates=20250419 \
         tmux=3.5a-3 \
         openssh-client=1:10.0p1-7+deb13u4 \
    && npm ci --omit=dev --ignore-scripts --prefix /opt/provider-cli \
    && node /opt/provider-cli/node_modules/@anthropic-ai/claude-code/install.cjs \
    && ln -s /opt/provider-cli/node_modules/.bin/codex /usr/local/bin/codex \
    && ln -s /opt/provider-cli/node_modules/.bin/claude /usr/local/bin/claude \
    && ln -s /usr/local/bin/agentops-github-credential-helper /usr/local/bin/gh \
    && ln -s /usr/local/bin/agentops-github-credential-helper /usr/local/bin/agentops-git-askpass \
    && useradd --uid 65532 --create-home --home-dir /home/agentops \
         --shell /bin/sh agentops \
    && mkdir -p /workspace \
    && chown agentops:agentops /workspace \
    && /usr/local/libexec/agentops-gh-real pr merge --help \
       | grep -q -- '--match-head-commit' \
    && codex --version \
    && claude --version \
    && rm -rf /usr/local/lib/node_modules/npm \
    && rm -rf /opt/yarn-v* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && rm -rf /var/lib/apt/lists/*
ENV HOME=/home/agentops \
    AGENTOPS_REPOSITORY_ROOT=/app \
    AGENTOPS_APP_ROOT=/app \
    AGENTOPS_WORKSPACE_ROOT=/workspace \
    AGENTOPS_STORE_ROOT=/workspace/store \
    AGENTOPS_SYSTEM_DIR=/app/docs/_system
WORKDIR /app
USER agentops
ENTRYPOINT ["node", "apps/agentops/dist/src/runner/cli.js"]

# --- triage-runner: Issue-only broker + provider + comment/label capability ----------------------
# This image deliberately has no git, ssh, tmux, bubblewrap, checkout volume, or
# development GitHub credential. The root filesystem is made read-only by the
# runtime; only /tmp and /home/agentops are tmpfs.
FROM node:24.19.0-trixie-slim@sha256:85498d7fd8e2bc0b02abb1792ef27341559836236dd0b1af160fa66bb85148df AS triage-runner
USER root
COPY --chown=root:root deploy/tools/provider-cli/package.json deploy/tools/provider-cli/package-lock.json /opt/provider-cli/
COPY --from=runner-tools /out/gh /usr/local/libexec/agentops-gh-real
COPY --from=control-build /out/agentops-github-credential-helper /usr/local/bin/agentops-github-credential-helper
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260804T000000Z trixie main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260804T000000Z trixie-updates main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260804T000000Z trixie-security main' \
      > /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates=20250419 \
    && npm install --global npm@12.0.2 \
    && npm --version | grep -qx '12.0.2' \
    && npm ci --omit=dev --ignore-scripts --prefix /opt/provider-cli \
    && node /opt/provider-cli/node_modules/@anthropic-ai/claude-code/install.cjs \
    && ln -s /opt/provider-cli/node_modules/.bin/codex /usr/local/bin/codex \
    && ln -s /opt/provider-cli/node_modules/.bin/claude /usr/local/bin/claude \
    && ln -s /usr/local/bin/agentops-github-credential-helper /usr/local/bin/gh \
    && ln -s /usr/local/bin/agentops-github-credential-helper /usr/local/bin/agentops-git-askpass \
    && useradd --uid 65532 --create-home --home-dir /home/agentops \
         --shell /usr/sbin/nologin agentops \
    && /usr/local/libexec/agentops-gh-real version \
    && codex --version \
    && claude --version \
    && rm -rf /usr/local/lib/node_modules/npm \
    && rm -rf /opt/yarn-v* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=agentops:agentops /app /app
ENV HOME=/home/agentops \
    YARN_VERSION= \
    AGENTOPS_REPOSITORY_ROOT=/app \
    AGENTOPS_APP_ROOT=/app
WORKDIR /app
USER agentops
ENTRYPOINT ["node", "apps/agentops/dist/src/triage/cli.js"]

# --- github-broker: the only process that can read the GitHub App private key -------------------
# The host never publishes this listener. Workers reach it only over the
# agentops internal network and authenticate with role-derived capabilities.
#
# WORKDIR is required, not cosmetic. Without it the runtime starts the process in
# $HOME, and `agentopsctl` runs the key-seeding helper from this image as root with
# `--cap-drop ALL --cap-add CAP_CHOWN`. Dropping CAP_DAC_OVERRIDE is what makes that
# root unable to enter the 0700 nonroot home, so the process fails to start before
# it can seed the key. `/` is traversable by every uid, so both the seeding root and
# the 65532 broker start there. Sibling targets already set WORKDIR; this one did not.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:f7f8f729987ad0fdf6b05eeeae94b26e6a0f613bdf46feea7fc40f7bd72953e6 AS github-broker
ENV HOME=/home/nonroot \
    AGENTOPS_GITHUB_BROKER_LISTEN=0.0.0.0:8083
COPY --from=control-build /out/agentops-github-broker /usr/local/bin/agentops-github-broker
COPY --from=control-build /out/agentops-github-credential-helper /usr/local/bin/agentops-github-credential-helper
WORKDIR /
USER 65532:65532
EXPOSE 8083
ENTRYPOINT ["/usr/local/bin/agentops-github-broker"]

# --- control: credential-free Go control plane ---------------------------------------------------
# The CISO-07 private-repository topology accepts signed webhook ingress and
# runner-brokered polls in both modes; it intentionally omits the
# credential-bearing gh forwarder CLI. The fixed nonroot distroless base
# leaves no shell/package manager.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:f7f8f729987ad0fdf6b05eeeae94b26e6a0f613bdf46feea7fc40f7bd72953e6 AS control
ENV AGENTOPS_APP_ROOT=/app \
    AGENTOPS_CONTROL_LISTEN=127.0.0.1:8081 \
    AGENTOPS_CONTROL_PROXY_LISTEN=0.0.0.0:8080 \
    HOME=/home/nonroot
WORKDIR /app
COPY --from=control-build /out/agentops-control /usr/local/bin/agentops-control
COPY --from=control-build /src/contracts /app/contracts
COPY --from=control-build /src/evidence /app/evidence
COPY --from=control-build /src/db /app/db
COPY --from=control-build /src/docs /app/docs
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/agentops-control"]

# --- postgres-tools: rebuild gosu on the current pinned Go security patch -------------------------
FROM control-build AS postgres-tools
WORKDIR /src/deploy/tools/gosu
COPY deploy/tools/gosu/go.mod deploy/tools/gosu/go.sum ./
RUN go mod download
COPY deploy/tools/gosu ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
      -o /out/gosu github.com/tianon/gosu \
    && /out/gosu --version

# --- postgres: pinned standard-OCI persistence boundary ------------------------------------------
# agentopsctl builds and runs this target instead of pulling a mutable tag at deployment time.
# The upstream entrypoint retains PostgreSQL's volume initialization semantics; agentopsctl owns
# role-separated bootstrap, migrations, readiness, rollback-safe failure, and the named volume.
FROM postgres:18.4-trixie@sha256:3a82e1f56c8f0f5616a11103ac3d47e632c3938698946a7ad26da0df1334744a AS postgres-rootfs
COPY --from=postgres-tools /out/gosu /usr/local/bin/gosu
RUN rm -f /etc/ssl/private/ssl-cert-snakeoil.key \
      /etc/ssl/certs/ssl-cert-snakeoil.pem

# Flatten the sanitized final filesystem into a new OCI stage so a layer-aware
# secret scanner cannot recover the removed upstream snakeoil private key.
FROM scratch AS postgres
COPY --from=postgres-rootfs / /
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/postgresql/18/bin \
    GOSU_VERSION=1.19 \
    LANG=en_US.utf8 \
    PG_MAJOR=18 \
    PG_VERSION=18.4-1.pgdg13+1 \
    PGDATA=/var/lib/postgresql/18/docker
LABEL org.opencontainers.image.source="https://github.com/mrbaron3/servo" \
      org.opencontainers.image.title="AgentOps PostgreSQL" \
      org.opencontainers.image.description="Pinned PostgreSQL persistence boundary for AgentOps"
STOPSIGNAL SIGINT
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["postgres"]
HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=12 \
  CMD ["pg_isready", "-U", "postgres", "-d", "agentops"]
