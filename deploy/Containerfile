# Standard OCI application image for the AgentOps harness (AC-CISO-011).
#
# This is a plain multi-stage OCI build — no Apple-Container-specific syntax — so it builds and runs
# identically under Apple Container, docker, podman, or nerdctl. The runtime adapter, not the image,
# carries any engine-specific behaviour. Every path here is container-absolute (WORKDIR /app); nothing
# references a macOS `/Users/...` path, which the host-path scanner (src/runtime/paths.ts) enforces.
#
# Build context is the repository root:
#   container build -t agentops-app:dev -f deploy/Containerfile .
#   docker    build -t agentops-app:dev -f deploy/Containerfile .   # standard-OCI portability check
#
# Stage boundary keeps the TypeScript runner and Go control-plane release surfaces independent.

# --- deps: resolve the full dependency graph from the lockfile (reproducible) -------------------
FROM node:22-bookworm-slim AS deps
WORKDIR /app
# Only the manifest + lockfile, so this layer caches unless dependencies change.
COPY package.json package-lock.json ./
RUN npm ci

# --- build: bring in the source and prove build+typecheck run in-container from container-relative paths -
FROM deps AS build
WORKDIR /app
COPY . .
# Grounds "build/typecheck grader runs inside the container with no Mac absolute path" (issue #11 AC).
RUN npm run typecheck && npm run build

# --- control-build: compile and unit-test the Registration-driven Go control plane ----------------
FROM golang:1.24-bookworm AS control-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY contracts ./contracts
COPY evidence ./evidence
COPY db ./db
COPY docs ./docs
RUN go test ./... \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
      -o /out/agentops-control ./cmd/agentops-control \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
      -o /out/agentopsctl ./cmd/agentopsctl

# Integration-test target. It is run on the internal test network with AGENTOPS_TEST_DATABASE_URL;
# PostgreSQL does not publish a host port in the grounded Apple Container smoke.
FROM control-build AS control-test
CMD ["go", "test", "-race", "./..."]

# --- runtime: the application image ------------------------------------------------------------
# Runs the harness via the tsx launcher (bin/agentops.mjs). Retains the toolchain so the in-container
# graders (typecheck / unit tests) run against container-relative paths; a leaner prod-only split is a
# later concern (#14) and does not change this image's standard-OCI shape.
FROM node:22-bookworm-slim AS runtime
# git is part of the harness grader/runner toolchain (it shells out to git); install it reproducibly.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
# Container-neutral roots (DATA-container-runtime-004). AGENTOPS_APP_ROOT is CONSUMED by the CLI
# bootstrap (resolveHarnessRoot): Store / workspace / systemDir all anchor on it, so nothing depends on
# a macOS /Users path. The WORKSPACE/STORE roots are declared here for consumers that adopt
# resolveContainerPaths as workspace/store move onto dedicated volumes (#12/#14). None carries a macOS
# dependency; here APP_ROOT=/app equals the cwd, so behavior is identical to a bare run.
ENV NODE_ENV=production \
    AGENTOPS_APP_ROOT=/app \
    AGENTOPS_WORKSPACE_ROOT=/workspace \
    AGENTOPS_STORE_ROOT=/data/store \
    AGENTOPS_SYSTEM_DIR=/app/docs/_system
WORKDIR /app
# The official node image ships a non-root `node` user (uid 1000); run as it, never as root.
COPY --from=build --chown=node:node /app /app
USER node
CMD ["node", "bin/agentops.mjs"]

# --- runner: isolated PostgreSQL lease consumer + existing AgentOps toolchain --------------------
FROM runtime AS runner
USER root
ARG CODEX_VERSION=0.145.0
ARG CLAUDE_CODE_VERSION=2.1.220
COPY --chown=root:root deploy/agentops-git-askpass /usr/local/bin/agentops-git-askpass
RUN apt-get update \
    && apt-get install -y --no-install-recommends bubblewrap ca-certificates gh tmux openssh-client \
    && npm install --global \
         "@openai/codex@${CODEX_VERSION}" \
         "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && useradd --uid 65532 --create-home --home-dir /home/agentops \
         --shell /usr/sbin/nologin agentops \
    && mkdir -p /workspace \
    && chown agentops:agentops /workspace \
    && chmod 0755 /usr/local/bin/agentops-git-askpass \
    && gh pr merge --help | grep -q -- '--match-head-commit' \
    && codex --version \
    && claude --version \
    && rm -rf /var/lib/apt/lists/*
ENV HOME=/home/agentops \
    AGENTOPS_APP_ROOT=/app \
    AGENTOPS_WORKSPACE_ROOT=/workspace \
    AGENTOPS_STORE_ROOT=/workspace/store \
    AGENTOPS_SYSTEM_DIR=/app/docs/_system
WORKDIR /app
USER agentops
ENTRYPOINT ["node", "dist/src/runner/cli.js"]

# --- control: Go agentops-control + fixed gh forwarder adapter ------------------------------------
FROM debian:bookworm-slim AS control
ARG TARGETARCH
ARG GH_WEBHOOK_VERSION=v0.2.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gh \
    && useradd --uid 65532 --create-home --shell /usr/sbin/nologin agentops \
    && architecture="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && case "$architecture" in \
         amd64) checksum="685b6ff3106c76619c0203a4de6e0a1dfc9b229179c1c69afc26ecf766782683" ;; \
         arm64) checksum="2d213a3d6858ed7602b2564e9a407da80b011775913524d982f60e26b6720a47" ;; \
         *) echo "unsupported gh-webhook architecture: $architecture" >&2; exit 1 ;; \
       esac \
    && extension_dir=/home/agentops/.local/share/gh/extensions/gh-webhook \
    && mkdir -p "$extension_dir" \
    && curl --fail --location --retry 3 \
         "https://github.com/cli/gh-webhook/releases/download/${GH_WEBHOOK_VERSION}/linux-${architecture}" \
         --output "$extension_dir/gh-webhook" \
    && echo "$checksum  $extension_dir/gh-webhook" | sha256sum --check --strict \
    && chmod 0755 "$extension_dir/gh-webhook" \
    && chown -R agentops:agentops /home/agentops/.local \
    && runuser -u agentops -- env HOME=/home/agentops \
         XDG_DATA_HOME=/home/agentops/.local/share gh webhook --help >/dev/null \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*
ENV AGENTOPS_APP_ROOT=/app \
    AGENTOPS_CONTROL_LISTEN=127.0.0.1:8081 \
    AGENTOPS_CONTROL_PROXY_LISTEN=0.0.0.0:8080 \
    HOME=/home/agentops \
    XDG_DATA_HOME=/home/agentops/.local/share
WORKDIR /app
COPY --from=control-build /out/agentops-control /usr/local/bin/agentops-control
COPY --from=control-build /src/contracts /app/contracts
COPY --from=control-build /src/evidence /app/evidence
COPY --from=control-build /src/db /app/db
COPY --from=control-build /src/docs /app/docs
USER agentops
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/agentops-control"]
